# Copy to .env for local development. On Railway, set these as service Variables
# in the dashboard instead -- never commit real values.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "True" locally, "False" on Railway.
DEBUG=True

# Comma-separated. Railway also injects RAILWAY_PUBLIC_DOMAIN automatically,
# which settings.py appends on its own -- add custom domains here.
ALLOWED_HOSTS=localhost,127.0.0.1

# Set by Railway's Postgres add-on. Leave blank locally to use SQLite.
DATABASE_URL=

# Email. Do NOT name this PORT -- Railway uses PORT for the web server.
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_HOST_USER=thenaijaket@outlook.com
EMAIL_HOST_PASSWORD=
